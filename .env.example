# Requires an initialized replica set (or use a MongoDB Atlas URI).
# MONGODB_URI=mongodb://127.0.0.1:27017/restaurant-pos?replicaSet=rs0
MONGODB_URI=mongodb://localhost:27017,localhost:27018,localhost:27019/restaurant-pos?replicaSet=rs0
AUTH_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_APP_NAME=Restaurant POS
