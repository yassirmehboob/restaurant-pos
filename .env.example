# Requires an initialized replica set (or use a MongoDB Atlas URI).
# MONGODB_URI=mongodb://127.0.0.1:27017/restaurant-pos?replicaSet=rs0
MONGODB_URI=mongodb://localhost:27017,localhost:27018,localhost:27019/restaurant-pos?replicaSet=rs0
# Keep stable and back up securely: also encrypts enrolled authenticator keys.
AUTH_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_APP_NAME=Restaurant POS

# Backups are encrypted, restaurant-scoped snapshots including uploaded images.
# Store on a separate persistent directory or disk accessible to the app service.
# Default: ../restaurant-pos-backups (outside this project; never under public/).
# BACKUP_DIRECTORY=D:\restaurant-pos-backups
# Optional separate stable key (32+ random characters). Defaults to AUTH_SECRET.
# Keep both keys in a secure off-device recovery record; never rotate without a plan.
# BACKUP_ENCRYPTION_KEY=
# Maximum uncompressed archive size; raise for large menus/image libraries.
# BACKUP_MAX_SIZE_MB=256
# Optional Google Drive backup copies (see docs/BACKUPS.md). One Google Cloud OAuth
# "Web application" client for this server, shared by every restaurant; each owner
# then connects their own Drive under Setup > Backups & Restore. All three are required.
# The redirect URI must exactly match the client's authorized redirect URI.
# GOOGLE_DRIVE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/backups/google/callback

# SMS gateway base URL. The app appends /v1/messages.
# Each business stores its own subscription token in Business Profile settings.
# SMS_API=https://your-sms-gateway.example/

# Optional background waiter alerts. Supply these through deployment secrets
# to both the Next.js server and kitchen worker. Never commit real keys.
# Generate a stable keypair with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:owner@your-restaurant.example

# Login cookies are HTTPS-only in production. When `npm start` serves other PCs on the
# local network over plain http (e.g. http://192.168.1.10:3000), set this to false or
# logins will not stick on those PCs. Leave it unset for live hosting behind HTTPS.
# COOKIE_SECURE=false

# Optional QZ Tray trust (direct USB/LAN receipt printing). Without these, QZ Tray shows an
# "Allow" prompt on each PC. With a QZ certificate (bought from qz.io, or self-signed with
# override.crt installed on every PC) printing is silent. Paths to PEM files on the server.
# QZ_CERTIFICATE_PATH=D:\restaurant-pos-secrets\qz-certificate.txt
# QZ_PRIVATE_KEY_PATH=D:\restaurant-pos-secrets\qz-private-key.pem

# Staff photos are saved in <folder>/<businessId>/staff_photo. Keep this folder outside the project.
# Default when unset: a "restaurant-pos-uploads" folder next to the project folder.
# UPLOADS_DIRECTORY=D:/restaurant-pos-uploads
